# ==============================================================================
# LedgerCraft Invoice Generator - Environment Configuration
# ==============================================================================

# Port configuration (optional, defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Email Sending Configuration
# ------------------------------------------------------------------------------
# Option A: Zero Configuration (Default)
# If no email credentials are set below, LedgerCraft automatically uses
# Nodemailer's ephemeral Ethereal test inbox. It delivers the invoice and
# generates a direct preview link (https://ethereal.email/message/...) right in
# the app UI so you can inspect the delivered HTML email instantly!

# Option B: Resend (Recommended for production)
# RESEND_API_KEY=re_123456789_abcdef
# EMAIL_FROM=invoicing@yourdomain.com

# Option C: Custom SMTP (SendGrid, Mailgun, Postmark, AWS SES, or standard SMTP)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=billing@yourdomain.com
